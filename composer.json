{
    "name": "chr15k/laravel-schema-audit",
    "description": "Performs static analysis of your Laravel migrations to detect schema inconsistencies before they ship.",
    "type": "library",
    "authors": [
        {
            "name": "Chris Keller",
            "email": "ctk8501@gmail.com",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "keywords": [
        "chr15k",
        "laravel",
        "mysql",
        "migration",
        "schema",
        "index",
        "performance",
        "optimization",
        "static analysis"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Chr15k\\SchemaAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chr15k\\SchemaAudit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chr15k\\SchemaAudit\\SchemaAuditServiceProvider"
            ]
        }
    },
    "scripts": {
        "refactor": "rector",
        "lint": "pint --parallel",
        "fix": [
            "@lint",
            "@refactor",
            "@lint"
        ],
        "test:refactor": "rector --dry-run",
        "test:lint": "pint --test --parallel",
        "test:types": "phpstan analyse --ansi --memory-limit=2G",
        "test:tia": "pest --colors=always --parallel --tia",
        "test:coverage": "pest --colors=always --coverage --parallel --min=80",
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:coverage"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
